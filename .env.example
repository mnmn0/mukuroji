# ローカル開発用の設定の雛形です。`bun run local:setup` がこのファイルを元に `.env` を作り、
# 空の secret を `openssl rand -hex 32` 相当の値で埋めて `chmod 600` します。
# `.env` は git 管理外です。secret をこのファイルに書かないでください。

# Workspace audit の pseudonym key（64桁の小文字hex）。Docker Compose が Floci へ渡し、
# ready hook が形式を検証します。一度決めた値は変えないでください。
MUKUROJI_WORKSPACE_AUDIT_PSEUDONYM_KEY=

# Enterprise credential の hash secret（64桁の小文字hex、上と別の値）。host 上の `server:dev` と
# `floci:deploy-backend` だけが読み込み、Floci コンテナには渡しません。
ENTERPRISE_IDENTITY_TOKEN_HASH_SECRET=

# 任意: host に公開する port を変える場合だけ設定します。
# FLOCI_PORT=4566
# DYNAMODB_ADMIN_PORT=8001
