{
  "name": "server",
  "scripts": {
    "dev": "bun run --hot src/handlers/api.handler.ts",
    "build:lambda": "bun build src/handlers/api.handler.ts --target node --format esm --outfile dist/lambda/index.mjs && bun build src/handlers/enterprise-scim-group-job-worker-handler.ts --target node --format esm --outfile dist/lambda/enterprise-scim-group-job-worker.mjs",
    "build:connector-lambda": "bun build src/handlers/connector-handler.ts --target node --format esm --outfile dist/lambda/connector-handler.mjs",
    "test": "bun test --max-concurrency 1 src scripts",
    "audit:backfill": "bun run scripts/backfills/backfill-audit-events.ts",
    "search:backfill": "bun run scripts/backfills/backfill-workspace-search.ts",
    "search:migration:control": "bun run scripts/migrations/workspace-search-v1/migration-control-cli.ts",
    "search:migration:rehearsal:permit": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-permit-cli.ts",
    "search:migration:rehearsal:manifest": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-stage-manifest-cli.ts",
    "search:migration:rehearsal:alarms": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-alarm-evidence-cli.ts",
    "search:migration:rehearsal:ingest-alarm-signal": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-alarm-ingestion-cli.ts",
    "search:migration:rehearsal:run": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-process-cli.ts",
    "search:migration:rehearsal:finalize-stage": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-stage-finalizer-cli.ts",
    "search:migration:rehearsal:commit-stage": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-stage-commit-cli.ts",
    "search:migration:rehearsal:abandon-stage": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-stage-abandon-cli.ts",
    "search:migration:rehearsal:reconcile": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-reconciliation-cli.ts",
    "search:migration:rehearsal:publish": "bun run scripts/migrations/workspace-search-v1/migration-rehearsal-publication-cli.ts",
    "work-items:integrity": "bun run scripts/data-integrity/verify-work-items-integrity.ts",
    "cross-domain:integrity": "bun run scripts/data-integrity/verify-cross-domain-integrity.ts",
    "restore-drill:approve-cleanup": "bun run scripts/restore-drill/create-cleanup-approval.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1057.0",
    "@aws-sdk/client-appconfigdata": "3.1057.0",
    "@aws-sdk/client-cloudwatch": "3.1057.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1057.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1057.0",
    "@aws-sdk/client-dynamodb": "3.1057.0",
    "@aws-sdk/client-kms": "3.1057.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-secrets-manager": "^3.1057.0",
    "@aws-sdk/client-sfn": "3.1057.0",
    "@aws-sdk/client-sqs": "^3.1057.0",
    "@aws-sdk/client-sts": "3.1057.0",
    "@aws-sdk/credential-provider-ini": "3.973.1",
    "@aws-sdk/lib-dynamodb": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@mukuroji/contracts": "workspace:*",
    "@smithy/core": "3.30.0",
    "@smithy/node-http-handler": "4.9.5",
    "hono": "^4.12.21"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pdfjs-dist": "^6.1.200"
  }
}
