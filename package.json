{
  "name": "mukuroji",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "contracts",
    "web",
    "server",
    "cdk"
  ],
  "scripts": {
    "floci:up": "docker compose up -d floci",
    "floci:down": "docker compose down",
    "oxc:lint": "oxlint .",
    "oxc:lint:github": "oxlint . --format=github",
    "oxc:lint:ci": "oxlint . --format=github --deny-warnings",
    "typecheck:contracts": "tsc -p contracts/tsconfig.json --noEmit --pretty false",
    "typecheck:api-contract": "tsc -p scripts/tsconfig.public-api-contract.json --noEmit --pretty false",
    "typecheck:server": "tsc -p server/tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck": "bun run typecheck:contracts && bun run typecheck:api-contract && bun run typecheck:server && bun run web:build && bun run cdk:build",
    "dependencies:check": "depcruise --validate --output-type err server/src server/scripts web/src cdk/lib cdk/bin contracts/src",
    "knip:check": "knip --reporter compact --include files,dependencies,unlisted,binaries,unresolved,catalog",
    "api:contract:check": "bun scripts/check-public-api-contract.ts",
    "api:contract:test": "bun test scripts/check-public-api-contract.test.ts",
    "api:contract:update": "bun scripts/check-public-api-contract.ts --update",
    "skill:validate": "bun scripts/validate-mukuroji-review-skill.ts",
    "skill:validate:test": "bun test scripts/validate-mukuroji-review-skill.test.ts",
    "cdk:nag": "bun --filter cdk nag",
    "web:dev": "bun --filter web dev",
    "web:lint": "bun --filter web lint",
    "web:lint:ci": "bun --filter web lint:ci",
    "web:test": "bun --filter web test",
    "web:build": "bun --filter web build",
    "web:e2e": "playwright test",
    "web:storybook": "bun --filter web storybook",
    "web:build-storybook": "bun --filter web build-storybook",
    "server:dev": "bun --env-file=.env --filter server dev",
    "server:build:lambda": "bun --filter server build:lambda",
    "server:test": "bun --filter server test",
    "ai-assistance:eval": "bun --filter server ai-assistance:eval",
    "ai-assistance:eval:live": "bun server/scripts/ai-assistance/evaluate-ai-assistance-live.ts",
    "work-items:integrity": "bun server/scripts/data-integrity/verify-work-items-integrity.ts",
    "cross-domain:integrity": "bun server/scripts/data-integrity/verify-cross-domain-integrity.ts",
    "restore-drill:approve-cleanup": "bun --filter server restore-drill:approve-cleanup",
    "floci:deploy-backend": "bun --env-file=.env run sh floci/deploy-backend.sh",
    "work-items:seed-dynamodb": "bash scripts/seed-work-items-dynamodb.sh",
    "issues:check-dynamodb": "bash scripts/check-team-issues-dynamodb.sh",
    "audit:backfill": "bun --env-file=.env --filter server audit:backfill",
    "team-issue-comments:backfill": "bun --env-file=.env --filter server team-issue-comments:backfill",
    "search:backfill": "bun --filter server search:backfill",
    "cdk:build": "bun --filter cdk build",
    "cdk:test": "bun --filter cdk test",
    "cdk:synth": "bun --filter cdk cdk synth -c triageIndexDeploymentStage=wake -c teamIssueCommentIndexDeploymentStage=comment"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.27.0",
    "oxlint": "^1.70.0",
    "oxlint-plugin-awscdk": "^0.1.3",
    "typescript": "^6.0.3"
  }
}
