{
  "name": "mukuroji",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "contracts",
    "web",
    "server",
    "cdk"
  ],
  "scripts": {
    "mcp:start": "bun server/src/handlers/coding-agent-mcp.ts",
    "mcp:build": "bun scripts/build-coding-agent-mcp.ts",
    "mcp:release-notes": "bun server/scripts/coding-agent-mcp/release-notes.ts",
    "dev": "bun scripts/dev-local.ts",
    "dev:down": "docker compose down",
    "local:setup": "bun scripts/local-env.ts",
    "local:setup:test": "bun test scripts/local-env.test.ts",
    "local:files:scan": "bun --env-file=.floci/generated/services.env server/scripts/local-files/simulate-malware-scan.ts",
    "floci:up": "sh floci/up.sh",
    "floci:up:lambda": "FLOCI_ENABLE_LAMBDA=1 sh floci/up.sh",
    "floci:tables": "bun --filter cdk floci:tables",
    "workers:dev": "bun --env-file=.env --env-file=.floci/generated/cognito.env --env-file=.floci/generated/services.env server/scripts/local-workers/run.ts",
    "workers:once": "bun run workers:dev --once",
    "floci:down": "docker compose down",
    "oxc:lint": "oxlint .",
    "oxc:lint:github": "oxlint . --format=github",
    "oxc:lint:ci": "oxlint . --format=github --deny-warnings",
    "typecheck:contracts": "tsc -p contracts/tsconfig.json --noEmit --pretty false",
    "typecheck:api-contract": "tsc -p scripts/tsconfig.public-api-contract.json --noEmit --pretty false",
    "typecheck:scripts": "tsc -p scripts/tsconfig.operator-scripts.json --noEmit --pretty false",
    "typecheck:server": "tsc -p server/tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck": "bun run typecheck:contracts && bun run typecheck:api-contract && bun run typecheck:server && bun run web:build && bun run cdk:build",
    "dependencies:check": "depcruise --validate --output-type err server/src server/scripts web/src cdk/lib cdk/bin contracts/src",
    "knip:check": "knip --reporter compact --include files,dependencies,unlisted,binaries,unresolved,catalog",
    "api:contract:check": "bun scripts/check-public-api-contract.ts",
    "api:contract:test": "bun test scripts/check-public-api-contract.test.ts",
    "api:contract:update": "bun scripts/check-public-api-contract.ts --update",
    "skill:validate": "bun scripts/validate-mukuroji-review-skill.ts",
    "skill:validate:test": "bun test scripts/validate-mukuroji-review-skill.test.ts",
    "cdk:nag": "bun --filter cdk nag",
    "runtime-control:enable": "bun scripts/runtime-control.ts enable",
    "runtime-control:disable": "bun scripts/runtime-control.ts disable",
    "runtime-control:read-only": "bun scripts/runtime-control.ts read-only",
    "runtime-control:test": "bun test scripts/runtime-control.test.ts",
    "scripts:test": "bun test scripts/runtime-control.test.ts scripts/github-deploy.test.ts scripts/local-env.test.ts scripts/serve-static-directory.test.ts scripts/inject-web-csp-meta.test.ts scripts/check-web-bundle-budget.test.ts scripts/post-deploy-smoke.test.ts scripts/seed-demo-data.test.ts",
    "deploy:github": "bun scripts/github-deploy.ts",
    "deploy:github:test": "bun test scripts/github-deploy.test.ts",
    "deploy:smoke": "bun scripts/post-deploy-smoke.ts",
    "deploy:smoke:test": "bun test scripts/post-deploy-smoke.test.ts",
    "demo-data:remove": "bun cdk/scripts/remove-demo-data.ts",
    "demo-data:seed": "bun scripts/seed-demo-data.ts",
    "web:dev": "bun --filter web dev",
    "web:lint": "bun --filter web lint",
    "web:lint:ci": "bun --filter web lint:ci",
    "web:test": "bun --filter web test",
    "web:build": "bun --filter web build",
    "web:preview": "bun --filter web preview",
    "web:deploy": "bash scripts/deploy-web.sh",
    "web:rollback": "bash scripts/rollback-web.sh",
    "pwa:icons": "bun scripts/generate-pwa-icons.ts",
    "web:e2e": "playwright test && bun run web:e2e:pwa",
    "web:e2e:desktop": "playwright test",
    "web:e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "web:e2e:real-server": "playwright test -c playwright.real-server.config.ts",
    "web:visual": "playwright test -c playwright.visual.config.ts",
    "web:visual:docker": "sh scripts/run-visual-regression-in-container.sh",
    "web:budget": "bun scripts/check-web-bundle-budget.ts",
    "web:budget:test": "bun test scripts/check-web-bundle-budget.test.ts scripts/post-deploy-smoke.test.ts",
    "web:csp-meta:test": "bun test scripts/inject-web-csp-meta.test.ts",
    "web:storybook": "bun --filter web storybook",
    "web:build-storybook": "bun --filter web build-storybook",
    "server:dev": "bun --env-file=.env --env-file=.floci/generated/cognito.env --env-file=.floci/generated/services.env --filter server dev",
    "server:build:lambda": "bun --filter server build:lambda",
    "server:test": "bun --filter server test",
    "ai-assistance:eval": "bun --filter server ai-assistance:eval",
    "ai-assistance:eval:live": "bun server/scripts/ai-assistance/evaluate-ai-assistance-live.ts",
    "work-items:integrity": "bun server/scripts/data-integrity/verify-work-items-integrity.ts",
    "cross-domain:integrity": "bun server/scripts/data-integrity/verify-cross-domain-integrity.ts",
    "data:migrate": "bun server/scripts/migrations/run-data-migration.ts",
    "data:migrate:aws": "bun server/scripts/migrations/invoke-data-migration-lambda.ts",
    "data:migrate:rehearsal": "bun server/scripts/migrations/rehearse-data-migration.ts",
    "agent-runs:integrity": "bun server/scripts/data-integrity/verify-agent-runs-integrity.ts",
    "restore-drill:approve-cleanup": "bun --filter server restore-drill:approve-cleanup",
    "floci:deploy-backend": "bun --env-file=.env run sh floci/deploy-backend.sh",
    "work-items:seed-dynamodb": "bash scripts/seed-work-items-dynamodb.sh",
    "issues:check-dynamodb": "bash scripts/check-team-issues-dynamodb.sh",
    "search:backfill": "bun --filter server search:backfill",
    "cdk:build": "bun --filter cdk build",
    "cdk:test": "bun --filter cdk test",
    "cdk:synth": "bun --filter cdk cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb-streams": "3.1057.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.27.0",
    "oxlint": "^1.70.0",
    "oxlint-plugin-awscdk": "^0.1.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@modelcontextprotocol/server": "2.3.0",
    "fflate": "0.8.3"
  }
}
